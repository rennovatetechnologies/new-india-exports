{
  "name": "backend",
  "version": "2.3.0",
  "description": "VIRASTRA / New India Export production API (OTP auth, cases, Razorpay, GST invoices, Drive, SMTP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "build": "node --check server.js && node --check config.js && node --check db.js",
    "check": "node --check server.js && for f in routes/*.js services/*.js services/**/*.js middleware/*.js schemas/*.js; do node --check \"$f\" || exit 1; done",
    "db:setup": "node scripts/setupDatabases.js",
    "drive:oauth": "node scripts/googleDriveOAuth.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.16.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.6",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  }
}
