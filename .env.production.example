# =============================================================================
# Backend PRODUCTION / Railway template
# Real values are GitHub Actions secrets (repo: rennovatetechnologies/new-india-exports)
# and Railway service variables (same names).
#
# Copy to `.env.production.local` for a local prod-shaped run (gitignored).
# Do NOT set PORT — Railway provides it.
# =============================================================================

APP_ENV=production

# --- MongoDB (prod database on the same cluster) ---
MONGODB_URI=mongodb+srv://USER:PASS@virastra.09x6m5p.mongodb.net/?retryWrites=true&w=majority&appName=virastra
MONGODB_DB_NAME=virastra_prod
MONGODB_DB_NAME_NONPROD=virastra_nonprod
MONGODB_DB_NAME_PROD=virastra_prod

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=2

# --- Frontend pairing ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://india-exports-hub-53-production.up.railway.app
FRONTEND_URL=https://india-exports-hub-53-production.up.railway.app
ENABLE_DOCS=true
ENABLE_LEGACY_SHIPMENT=false

# --- Razorpay ---
# LIVE keys are not available yet. TEST keys are used in production until confirmed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (INR rupees) ---
GST_RATE=0.18
WORKSHOP_AMOUNT_INR=6399
BOOKING_AMOUNT_INR=100

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT=5
DISABLE_RATE_LIMITS=false

# Audit logs in Mongo. Auto-deleted after N days (default 7).
AUDIT_LOG_TTL_DAYS=7

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
MAX_CASE_UPLOAD_BYTES=15728640

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VIRASTRA <noreply@example.com>
MAIL_REPLY_TO=
OPS_INBOX=ops@newindiaexport.com
ADMIN_INBOX=admin@newindiaexport.com
SUPPORT_EMAIL=
APP_NAME=VIRASTRA

# --- Google Cloud Storage (PROD/ prefix when APP_ENV=production) ---
GCS_BUCKET=virastra
GCS_PROJECT_ID=virastra-504906
GCS_ENV_FOLDER=PROD
# Paste the full service-account JSON as a single-line secret (no key file on Railway).
GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"virastra-504906"}
