# =============================================================================
# Backend PRODUCTION / Railway template
# Real values are GitHub Actions secrets (repo: rennovatetechnologies/new-india-exports)
# and Railway service variables (same names).
#
# Copy to `.env.production.local` for a local prod-shaped run (gitignored).
# Do NOT set PORT — Railway provides it.
#
# Source of truth: GitHub Actions secrets (same names). Railway cannot
# read GitHub secrets on deploy — run `node scripts/pushGithubSecrets.js`
# then workflow "Sync GitHub secrets to Railway" (needs RAILWAY_TOKEN,
# RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID).
# =============================================================================

APP_ENV=production

# --- MongoDB (prod database on the same cluster) ---
MONGODB_URI=mongodb+srv://USER:PASS@virastra.09x6m5p.mongodb.net/?retryWrites=true&w=majority&appName=virastra
MONGODB_DB_NAME=virastra_prod
MONGODB_DB_NAME_NONPROD=virastra_nonprod
MONGODB_DB_NAME_PROD=virastra_prod

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=2

# --- Frontend pairing ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://india-exports-hub-53-production.up.railway.app,https://www.virastrainternationalexport.com,https://virastrainternationalexport.com
FRONTEND_URL=https://www.virastrainternationalexport.com
ENABLE_DOCS=true
ENABLE_LEGACY_SHIPMENT=false

# --- Razorpay (LIVE — real values live in GitHub / Railway secrets) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (INR rupees) ---
GST_RATE=0.18
WORKSHOP_AMOUNT_INR=6399
BOOKING_AMOUNT_INR=100

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT=5
DISABLE_RATE_LIMITS=false

# --- Notification channels ---
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_EMAIL_OTP=true
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_WHATSAPP_OTP=false

# --- WhatsApp Cloud API (Meta) — fill when you have creds, then set ENABLE_WHATSAPP_* true ---
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WHATSAPP_OTP_TEMPLATE=virastra_otp
# WHATSAPP_OTP_TEMPLATE_LANG=en
# WHATSAPP_OTP_BUTTON=copy_code
# WHATSAPP_NOTIFY_TEMPLATE=
# WHATSAPP_NOTIFY_TEMPLATE_LANG=en
# WHATSAPP_ALLOW_SESSION_TEXT=false

# Audit logs in Mongo. Auto-deleted after N days (default 7).
AUDIT_LOG_TTL_DAYS=7

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
MAX_CASE_UPLOAD_BYTES=15728640

# --- Resend ---
# Domain must be verified: https://resend.com/domains
# On Railway, set these and delete SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASS.
# MAIL_FROM cannot be a Gmail address.
RESEND_API_KEY=
MAIL_FROM="VIRASTRA by New India Export <noreply@virastrainternationalexport.com>"
MAIL_REPLY_TO=support@virastrainternationalexport.com
OPS_INBOX=ops@virastrainternationalexport.com
ADMIN_INBOX=admin@virastrainternationalexport.com
SUPPORT_EMAIL=support@virastrainternationalexport.com
SUPPORT_WHATSAPP=9967084149
APP_NAME="VIRASTRA by New India Export"

# --- Google Cloud Storage (customer files: PROD/ prefix when APP_ENV=production) ---
# Brochures live in SHARED/admin/brochures/ so both envs serve the same PDFs.
GCS_BUCKET=virastra
GCS_PROJECT_ID=virastra-504906
GCS_ENV_FOLDER=PROD
# Paste the full service-account JSON as a single-line secret (no key file on Railway).
GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"virastra-504906"}
