APP_ENV=development
PORT=5001
MONGODB_URI=mongodb+srv://USER:PASS@virastra.09x6m5p.mongodb.net/?retryWrites=true&w=majority&appName=virastra
MONGODB_DB_NAME=virastra_nonprod
MONGODB_DB_NAME_NONPROD=virastra_nonprod
MONGODB_DB_NAME_PROD=virastra_prod
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
ENABLE_DOCS=true
ENABLE_LEGACY_SHIPMENT=false

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing (INR rupees)
GST_RATE=0.18
WORKSHOP_AMOUNT_INR=6399
BOOKING_AMOUNT_INR=100

# OTP
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT=5
# When true, all API rate limiters are no-ops (default true unless APP_ENV=production)
DISABLE_RATE_LIMITS=true

# Uploads
MAX_UPLOAD_BYTES=5242880
MAX_CASE_UPLOAD_BYTES=15728640

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VIRASTRA <noreply@example.com>
MAIL_REPLY_TO=
OPS_INBOX=ops@newindiaexport.com
ADMIN_INBOX=admin@newindiaexport.com
SUPPORT_EMAIL=
APP_NAME=VIRASTRA

# Google Drive
# Option A (recommended without Workspace Shared Drive): OAuth as folder owner
# Run: node scripts/googleDriveOAuth.js  → paste refresh token below
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:5055/oauth2callback
# Option B: service account + Shared Drive (SA cannot upload to My Drive)
# 1) Create/use a Shared Drive, put Virastra/{pre-prod|prod} inside it
# 2) Add the service account as Content Manager
# 3) Set GOOGLE_DRIVE_SHARED_DRIVE_ID (required) + ROOT_FOLDER_ID
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Explicit override, else NONPROD vs PROD by APP_ENV
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID_NONPROD=
GOOGLE_DRIVE_ROOT_FOLDER_ID_PROD=
# GOOGLE_DRIVE_SHARED_DRIVE_ID=
