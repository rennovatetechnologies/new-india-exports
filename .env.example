# =============================================================================
# Backend LOCAL / development template
# Copy to `.env` (gitignored). Never commit real secrets.
#
# Production / Railway values live in GitHub Actions secrets (same names)
# and are documented in `.env.production.example`.
# =============================================================================

APP_ENV=development
# Local only. Do NOT set PORT on Railway — Railway injects it.
PORT=5001

# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASS@virastra.09x6m5p.mongodb.net/?retryWrites=true&w=majority&appName=virastra
MONGODB_DB_NAME=virastra_nonprod
MONGODB_DB_NAME_NONPROD=virastra_nonprod
MONGODB_DB_NAME_PROD=virastra_prod

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=2

# --- Frontend pairing ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
ENABLE_DOCS=true
ENABLE_LEGACY_SHIPMENT=false

# --- Razorpay (test keys until live keys are confirmed) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (INR rupees) ---
GST_RATE=0.18
WORKSHOP_AMOUNT_INR=6399
BOOKING_AMOUNT_INR=100

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT=5
# When true, all API rate limiters are no-ops (default true unless APP_ENV=production)
DISABLE_RATE_LIMITS=true

# Audit logs in Mongo (audit_logs). Auto-deleted after N days. Default 7.
AUDIT_LOG_TTL_DAYS=7

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
MAX_CASE_UPLOAD_BYTES=15728640

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VIRASTRA <noreply@example.com>
MAIL_REPLY_TO=
OPS_INBOX=ops@newindiaexport.com
ADMIN_INBOX=admin@newindiaexport.com
SUPPORT_EMAIL=
APP_NAME=VIRASTRA

# --- Google Cloud Storage ---
# Bucket layout: gs://virastra/{DEV|PROD}/customers/{user}/…
# Local: path to the service-account JSON file.
# Railway: set GCS_CREDENTIALS_JSON to the full JSON instead of a file.
GCS_BUCKET=virastra
GCS_PROJECT_ID=virastra-504906
GCS_KEY_FILE=virastra-504906-2c957972de4c.json
GOOGLE_APPLICATION_CREDENTIALS=virastra-504906-2c957972de4c.json
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"virastra-504906",...}
# Optional override; default is DEV unless APP_ENV=production
# GCS_ENV_FOLDER=DEV
