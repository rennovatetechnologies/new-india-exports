# =============================================================================
# Backend LOCAL / development template
# Copy to `.env` (gitignored). Never commit real secrets.
#
# Production / Railway values live in GitHub Actions secrets (same names)
# and are documented in `.env.production.example`.
# =============================================================================

APP_ENV=development
# Local only. Do NOT set PORT on Railway — Railway injects it.
PORT=5001

# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASS@virastra.09x6m5p.mongodb.net/?retryWrites=true&w=majority&appName=virastra
MONGODB_DB_NAME=virastra_nonprod
MONGODB_DB_NAME_NONPROD=virastra_nonprod
MONGODB_DB_NAME_PROD=virastra_prod

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=2

# --- Frontend pairing ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
ENABLE_DOCS=true
ENABLE_LEGACY_SHIPMENT=false

# --- Razorpay (TEST keys for local; LIVE keys are production-only) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (INR rupees) ---
GST_RATE=0.18
WORKSHOP_AMOUNT_INR=6399
BOOKING_AMOUNT_INR=100

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_RATE_LIMIT=5
# When true, all API rate limiters are no-ops (default true unless APP_ENV=production)
DISABLE_RATE_LIMITS=true

# --- Notification channels ---
# Flip these independently. WhatsApp stays off until Cloud API creds are set.
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_EMAIL_OTP=true
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_WHATSAPP_OTP=false

# --- WhatsApp Cloud API (Meta) ---
# Leave blank until you have a WhatsApp Business app. Then set ENABLE_WHATSAPP_* to true.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Auth template in Meta (category Authentication, copy-code button):
#   Body: {{1}} is your VIRASTRA by New India Export code. It expires in {{2}} minutes. Do not share this code.
# WHATSAPP_OTP_TEMPLATE=virastra_otp
# WHATSAPP_OTP_TEMPLATE_LANG=en
# WHATSAPP_OTP_BUTTON=copy_code
# Optional utility template for other alerts ({{1}} name, {{2}} message, {{3}} link):
# WHATSAPP_NOTIFY_TEMPLATE=
# WHATSAPP_NOTIFY_TEMPLATE_LANG=en
# Allow free-form text (dev / 24h session window). Keep false in production until templates are approved.
# WHATSAPP_ALLOW_SESSION_TEXT=true

# Audit logs in Mongo (audit_logs). Auto-deleted after N days. Default 7.
AUDIT_LOG_TTL_DAYS=7

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
MAX_CASE_UPLOAD_BYTES=15728640

# --- Resend ---
# Domain virastrainternationalexport.com must be verified at https://resend.com/domains
RESEND_API_KEY=
MAIL_FROM="VIRASTRA by New India Export <noreply@virastrainternationalexport.com>"
MAIL_REPLY_TO=support@virastrainternationalexport.com
OPS_INBOX=ops@virastrainternationalexport.com
ADMIN_INBOX=admin@virastrainternationalexport.com
SUPPORT_EMAIL=support@virastrainternationalexport.com
SUPPORT_WHATSAPP=9967084149
APP_NAME="VIRASTRA by New India Export"

# --- Google Cloud Storage ---
# Bucket layout: gs://virastra/{DEV|PROD}/customers/{user}/…
# Shared marketing PDFs: gs://virastra/SHARED/admin/brochures/
# Plans + brochures are mirrored in virastra_nonprod and virastra_prod.
# Events stay per-database (not shared).
# Local: path to the service-account JSON file.
# Railway: set GCS_CREDENTIALS_JSON to the full JSON instead of a file.
GCS_BUCKET=virastra
GCS_PROJECT_ID=virastra-504906
GCS_KEY_FILE=virastra-504906-2c957972de4c.json
GOOGLE_APPLICATION_CREDENTIALS=virastra-504906-2c957972de4c.json
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"virastra-504906",...}
# Optional override; default is DEV unless APP_ENV=production
# GCS_ENV_FOLDER=DEV
